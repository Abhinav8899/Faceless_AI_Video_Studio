[Unit]
Description=ComfyUI for the studio (started by `bin/<studio> start`, never at boot)

[Service]
Type=simple
WorkingDirectory=@COMFYUI@
Environment=VIRTUAL_ENV=@COMFYUI@/venv
Environment=PATH=@COMFYUI@/venv/bin:/usr/local/bin:/usr/bin:/bin
Environment=PYTHONUNBUFFERED=1
ExecStart=@COMFYUI@/venv/bin/python main.py --disable-smart-memory
StandardOutput=append:@REPO@/logs/comfyui.log
StandardError=append:@REPO@/logs/comfyui.log
TimeoutStopSec=30
