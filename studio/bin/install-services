#!/bin/bash
# Installs the two systemd *user* services that `bin/<studio> start` / `stop` control:
#   studio-comfyui.service   ComfyUI (shared by every studio on this machine)
#   <folder name>.service    this studio's inbox service
# Neither starts at boot (no [Install] section). Usage: bin/install-services [path/to/ComfyUI]
set -e
REPO="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
COMFYUI="$(cd "${1:-$HOME/ComfyUI}" && pwd)"
NAME="$(basename "$REPO")"
UNITS="$HOME/.config/systemd/user"
mkdir -p "$UNITS" "$REPO/logs"
test -x "$COMFYUI/venv/bin/python" || { echo "no $COMFYUI/venv/bin/python: pass your ComfyUI folder as the first argument"; exit 1; }
if [ -e "$UNITS/studio-comfyui.service" ]; then
  echo "studio-comfyui.service already exists (shared with another studio), keeping it"
else
  sed "s#@COMFYUI@#$COMFYUI#g; s#@REPO@#$REPO#g" "$REPO/systemd/studio-comfyui.service.in" > "$UNITS/studio-comfyui.service"
  echo "installed studio-comfyui.service"
fi
sed "s#@REPO@#$REPO#g" "$REPO/systemd/studio.service.in" > "$UNITS/$NAME.service"
echo "installed $NAME.service"
systemctl --user daemon-reload
echo "Optional, keeps renders running after you log out: sudo loginctl enable-linger $USER"
echo "Start with: $REPO/bin/$NAME start"
