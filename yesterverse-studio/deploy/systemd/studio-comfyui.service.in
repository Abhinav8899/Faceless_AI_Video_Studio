[Unit]
Description=ComfyUI for YesterVerse studio (started by `studio start`)

[Service]
Type=simple
WorkingDirectory=@COMFY@
Environment=PYTHONUNBUFFERED=1
Environment=PATH=@COMFY@/venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@COMFY_PY@ main.py --disable-smart-memory
StandardOutput=append:@REPO@/logs/comfyui.log
StandardError=append:@REPO@/logs/comfyui.log
TimeoutStopSec=30

# No [Install] section on purpose: nothing starts at boot. Use `studio start` / `studio stop`.
